# ---------------------------------------------------------------------------
# Dhaka Hotel - sample environment configuration
# Copy to .env and adjust for your machine. Never commit .env.
# ---------------------------------------------------------------------------

APP_ENV=local
# Keep off outside your own machine. With debug enabled PHP prints stack traces
# and database errors to the browser, which discloses paths and SQL.
APP_DEBUG=false
# Base URL path only matters for absolute links; leave empty at web root
APP_BASE_PATH=
# Public origin for og:url / canonical / sitemap. Set this on the live server.
APP_URL=
# Hostnames allowed to appear in generated absolute URLs when APP_URL is blank.
# Comma-separated; the first entry is used if the request Host is not listed.
TRUSTED_HOSTS=
APP_TIMEZONE=Asia/Dhaka
# Seeds fake reviews/orders and demo copy. Set to false once real data is in.
APP_DEMO_MODE=true
# Bump after changing CSS/JS so browsers fetch the new files
APP_ASSET_VERSION=1.0.0

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=dhaka_hotel_demo
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
# Optional: path to a CA bundle when the MySQL server requires TLS
DB_SSL_CA=

SESSION_NAME=dhakahotelsessid
SESSION_LIFETIME=7200
# auto | true | false  (auto = on when the request is HTTPS)
SESSION_SECURE=auto
SESSION_SAMESITE=Lax

# Owner contact details (fallbacks; the settings screen overrides these)
OWNER_EMAIL=
# Digits only, international format, e.g. 8801712345678
OWNER_WHATSAPP=

# SMTP - leave blank to keep the notification queue in "unconfigured" state
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Dhaka Hotel

# Allows `php database/reset_demo.php --confirm` to wipe the demo database.
# This truncates orders and resets restaurant_settings, so it must stay false on
# an installation that has taken real reservations or orders.
DEMO_RESET_ALLOWED=false
