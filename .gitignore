# Local environment (never commit credentials)
.env

# Database TLS material from the hosting provider. The CA bundle is tracked on
# purpose: it is a public trust anchor with no key in it, and shipping it in the
# image is the only CA route that survives a dashboard paste. Everything else -
# private keys, client certificates, pkcs12 bundles - stays out of history.
/certs/*
!/certs/*ca*.pem
/certs/*key*

# Composer
/vendor/

# Runtime data
/uploads/menu/*
!/uploads/menu/.gitkeep
/storage/
*.log

# OS / editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local tooling
/tools/
/node_modules/

